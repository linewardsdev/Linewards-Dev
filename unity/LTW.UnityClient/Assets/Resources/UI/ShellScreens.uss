/*
 * Line Wards shell screens: title, first-run offer, how to play, codex, pause, results — and the
 * coach strip that rides over a practice match.
 *
 * Authored against a 1080x1920 reference surface (see LineWardsShellPanelSettings), so every
 * length below is in reference units, not device pixels.
 *
 * Palette, from docs/BRANDING_GUIDE.md. Written as literals rather than as custom properties
 * on purpose: var() resolves through inheritance from wherever the sheet's :root matches, and
 * this sheet is attached to a UIDocument's sub-tree rather than to the panel root, so a :root
 * block here is not reliably in the inheritance chain. A palette that silently resolves to
 * nothing turns every surface transparent, which is a worse failure than repeating six hex codes.
 *
 *   night ink    #10182F     arcane blue  #4DA3FF     ward violet  #9B6CFF
 *   signal gold  #FFC84A     mint signal  #59E1B6     cloud        #F4F7FF
 *
 * Every alpha below is far lower than it looks like it should be, and that is deliberate. This
 * project renders in Linear colour space, so UI Toolkit composites alpha in LINEAR, not in the
 * sRGB numbers written here. Measured on a 1080x1920 capture: rgba(77,163,255,0.08) over the dark
 * field lands at sRGB (31,55,86) — where blending the sRGB values directly would give (18,29,47).
 * A tint authored by sRGB intuition therefore arrives roughly twice as strong as intended, which
 * is how a 12% row highlight came back as an opaque mustard bar. Opaque colours are unaffected and
 * measure pixel-exact against the palette above.
 *
 * Colour is never the only carrier of meaning. The primary action on each screen is also the
 * tallest, the widest and the first in reading order; the destructive action also carries a
 * written consequence line; a results row spells out WON / OUT / ALIVE as a word.
 */

/* ---------------------------------------------------------------- structure */

.ltw-shell {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/*
 * One screen. Hidden screens are display:none, so they cost no layout and cannot be picked; the
 * visible one fades and lifts in through .is-entered, which the presenter adds one frame after
 * the screen is shown so the transition has a resolved start value to run from.
 */
.ltw-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 200ms;
    transition-timing-function: ease-out;
}

.ltw-screen.is-shown {
    display: flex;
}

.ltw-screen.is-entered {
    opacity: 1;
}

/* The field a screen sits on. Opacity is per-screen; see the modifiers below. */
.ltw-field {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(9, 13, 27);
    -unity-background-scale-mode: stretch-to-fill;
    background-size: 100% 100%;
}

/* The title owns the display outright: no board reads through it. */
.ltw-field--solid {
    opacity: 1;
}

/*
 * Pause keeps the board legible underneath — it is a moment inside a match, not a new place.
 *
 * 0.91 rather than the 0.88 this started at. A pause lands on whatever the board happened to be
 * doing, and at 0.88 the capture caught PAUSED sitting across a creep and a green health bar. The
 * extra three points costs almost nothing in board legibility and buys a header that reads
 * cleanly whatever is behind it; the text shadows below do the rest.
 */
.ltw-field--veil {
    opacity: 0.91;
}

/* Results is heavier than pause: the match is over, the board is no longer actionable. */
.ltw-field--heavy {
    opacity: 0.95;
}

/* A soft ward-energy bloom, painted from a texture generated in ShellScreenView. */
.ltw-glow {
    position: absolute;
    -unity-background-scale-mode: stretch-to-fill;
    background-size: 100% 100%;
}

/*
 * Both bleed well past their own screen so the ellipse never shows an edge. The first pass kept
 * the glow inside the frame and it read as a lens flare sitting on the menu rather than as light
 * behind it — a visible boundary is what gives a soft blob away.
 */
#title-glow {
    left: -55%;
    right: -55%;
    top: -18%;
    height: 88%;
}

#results-glow {
    left: -50%;
    right: -50%;
    top: -26%;
    height: 72%;
}

.ltw-safe {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
}

/*
 * The content column. Capped rather than full-bleed so the composition stays a portrait column
 * on a tablet instead of stretching into a wide band of centred text.
 */
.ltw-column {
    width: 100%;
    max-width: 780px;
    flex-grow: 1;
    padding-left: 46px;
    padding-right: 46px;
    padding-top: 40px;
    padding-bottom: 46px;
    align-items: stretch;
    translate: 0 22px;
    transition-property: translate;
    transition-duration: 280ms;
    transition-timing-function: ease-out;
}

.ltw-screen.is-entered .ltw-column {
    translate: 0 0;
}

.ltw-spacer {
    flex-grow: 1;
    min-height: 20px;
}

/*
 * A half-weight spacer, for the side of a screen that should give up more of the slack.
 *
 * Every screen anchors its actions to the bottom, so how the leftover height is split is the whole
 * of the vertical composition. Pause and results put this above their content, which pulls the
 * headline up into a header instead of leaving it floating mid-board; the title puts it below,
 * which drops the wordmark to the optical centre rather than stranding it in the top third.
 * Splitting the slack evenly was the first attempt and it produced two voids per screen, which is
 * what makes a layout read as accidental rather than composed.
 */
.ltw-spacer--tight {
    /*
     * 0.5, not 0.4, and the difference is a flexbox rule rather than taste: when the flex-grow
     * values in a container sum to LESS than one, only that fraction of the free space is handed
     * out and the remainder is simply left at the end. Results uses this class on both of its
     * spacers, and at 0.4 each they summed to 0.8 — which parked 150px of unused column below the
     * last button and pulled the whole screen off the bottom edge. At 0.5 they sum to exactly one.
     */
    flex-grow: 0.5;
    min-height: 10px;
}

/*
 * Title-only rebalance of the same two spacers, per finding #14 of the 2026-09-01 render review:
 * "the button stack sits far below the wordmark with dead space between." At the old 1:0.5 split
 * the gap right above the buttons was still roughly a third of ALL the screen's leftover height,
 * because the reference canvas is tall relative to the fixed content on this screen and the split
 * did nothing to change that — only where the leftover landed. 5:1 keeps the sum well above one
 * (so this is a resize of the same two spacers, not a reach for the sum-below-one trick the
 * comment above just finished warning off) and hands the wordmark block most of the leftover,
 * which both reinforces its stated optical-centre placement and leaves a visibly tighter run
 * from the tagline into START GAME. Title-specific rather than edited in place on the shared
 * classes above, because pause and results deliberately use the opposite weighting for their own
 * reasons and were not part of this finding.
 */
.ltw-spacer--title-top {
    flex-grow: 1.25;
}

.ltw-spacer--title-actions {
    flex-grow: 0.25;
    min-height: 10px;
}

/* ---------------------------------------------------------------- typography */

/*
 * The brand SYMBOL only, above the wordmark — which stays as live text.
 *
 * Baking "LINE WARDS" into the image was the obvious move and the wrong one. Text reflows and
 * stays crisp at any density, and this is a phone-first game shipping to a wide range of screens;
 * a bitmap wordmark would have to be authored per size and could not be localised. The symbol has
 * no such problem, so the split is: distinctive mark as art, words as words.
 *
 * Sized in px to match the surrounding type scale rather than as a percentage, so it holds its
 * relationship to the wordmark under it instead of growing with the safe area.
 */
.ltw-brand-mark {
    background-image: resource("UI/brand_mark");
    -unity-background-scale-mode: scale-to-fit;
    width: 188px;
    height: 162px;
    align-self: center;
    margin-top: 0;
    margin-bottom: 18px;
}

.ltw-eyebrow {
    font-size: 21px;
    letter-spacing: 7px;
    color: rgb(77, 163, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-top: 0;
    margin-bottom: 14px;
    white-space: normal;
    text-shadow: 0 3px 12px rgba(4, 7, 16, 0.95);
}

.ltw-wordmark {
    font-size: 96px;
    letter-spacing: 4px;
    color: rgb(244, 247, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-top: 0;
    margin-bottom: 0;
    text-shadow: 0 6px 20px rgba(4, 7, 16, 0.95);
    white-space: nowrap;
}

.ltw-headline {
    font-size: 82px;
    letter-spacing: 6px;
    color: rgb(244, 247, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-top: 0;
    margin-bottom: 0;
    text-shadow: 0 6px 20px rgba(4, 7, 16, 0.95);
    white-space: nowrap;
}

.ltw-headline--won {
    color: rgb(255, 200, 74);
}

.ltw-rule {
    height: 3px;
    width: 140px;
    align-self: center;
    background-color: rgb(255, 200, 74);
    margin-top: 28px;
    margin-bottom: 26px;
}

.ltw-rule--quiet {
    background-color: rgba(77, 163, 255, 0.6);
    width: 104px;
    margin-top: 22px;
    margin-bottom: 20px;
}

.ltw-tagline {
    font-size: 31px;
    letter-spacing: 2px;
    color: rgb(150, 168, 205);
    -unity-text-align: middle-center;
    margin-top: 0;
    margin-bottom: 0;
    white-space: normal;
}

.ltw-note {
    font-size: 22px;
    color: rgb(150, 168, 205);
    -unity-text-align: middle-center;
    margin-top: 14px;
    margin-bottom: 0;
    white-space: normal;
    text-shadow: 0 3px 12px rgba(4, 7, 16, 0.95);
}

/* ---------------------------------------------------------------- actions */

/*
 * Three weights, and they differ by size and position as well as by fill. The primary is the
 * tallest and the first; the secondary is shorter and outlined; the tertiary carries no frame at
 * all. Read the stack in greyscale and the order is still obvious.
 *
 * Everything the default runtime theme puts on a Button is reset here — margin, padding and its
 * background image — because inheriting half of Unity's stock button and overriding the other
 * half is exactly how UI ends up looking like an engine default with a tint on it.
 */
.ltw-action {
    height: 100px;
    margin-left: 0;
    margin-right: 0;
    margin-top: 15px;
    margin-bottom: 0;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 0;
    padding-bottom: 0;
    background-image: none;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    font-size: 31px;
    letter-spacing: 4px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: nowrap;
    transition-property: all;
    transition-duration: 110ms;
    transition-timing-function: ease-out;
}

.ltw-action:hover {
    scale: 1.012 1.012;
}

.ltw-action:active {
    scale: 0.985 0.985;
}

.ltw-action--primary {
    height: 122px;
    font-size: 37px;
    background-color: rgb(255, 200, 74);
    border-color: rgb(255, 226, 152);
    color: rgb(22, 17, 4);
}

.ltw-action--primary:hover {
    background-color: rgb(255, 216, 124);
}

.ltw-action--secondary {
    height: 94px;
    font-size: 28px;
    background-color: rgba(77, 163, 255, 0.04);
    border-color: rgba(77, 163, 255, 0.5);
    color: rgb(244, 247, 255);
}

.ltw-action--secondary:hover {
    background-color: rgba(77, 163, 255, 0.09);
    border-color: rgb(77, 163, 255);
}

.ltw-action--tertiary {
    height: 76px;
    font-size: 24px;
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
    color: rgb(150, 168, 205);
}

.ltw-action--tertiary:hover {
    color: rgb(244, 247, 255);
    border-color: rgba(150, 168, 205, 0.42);
}

/*
 * Destructive. The violet frame separates it from the plain secondaries, and the consequence
 * line under it is what actually says why — because a frame on its own is only a colour.
 */
.ltw-action--caution {
    background-color: rgba(155, 108, 255, 0.035);
    border-color: rgba(155, 108, 255, 0.55);
    color: rgb(212, 222, 245);
}

.ltw-action--caution:hover {
    background-color: rgba(155, 108, 255, 0.08);
    border-color: rgba(155, 108, 255, 0.85);
}

.ltw-consequence {
    font-size: 19px;
    color: rgb(104, 122, 158);
    -unity-text-align: middle-center;
    margin-top: 8px;
    margin-bottom: 0;
    white-space: normal;
    text-shadow: 0 3px 12px rgba(4, 7, 16, 0.95);
}

/* ---------------------------------------------------------------- status strip */

.ltw-stats {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 26px;
}

.ltw-stat {
    flex-grow: 1;
    flex-basis: 0;
    align-items: center;
    padding-top: 16px;
    padding-bottom: 14px;
    background-color: rgba(77, 163, 255, 0.045);
    border-top-width: 2px;
    border-color: rgba(77, 163, 255, 0.34);
    margin-left: 5px;
    margin-right: 5px;
}

.ltw-stat__value {
    font-size: 42px;
    color: rgb(244, 247, 255);
    -unity-font-style: bold;
    margin-top: 0;
    margin-bottom: 0;
}

.ltw-stat__label {
    font-size: 17px;
    letter-spacing: 3px;
    color: rgb(104, 122, 158);
    margin-top: 4px;
    margin-bottom: 0;
}

/* ---------------------------------------------------------------- scoreboard */

.ltw-table {
    margin-top: 4px;
    margin-bottom: 4px;
}

/*
 * Every row carries a 4px left rail, transparent by default. The winner and the local seat colour
 * theirs in rather than filling the whole row, because a tinted band is the thing that went wrong
 * twice here: strong enough to see, it read as an opaque brown bar over the dark field; weak
 * enough not to, it read as nothing. A solid rail is unambiguous at any alpha, it keeps every row
 * on the same text baseline, and the row still says WON or OUT in words regardless.
 */
.ltw-row {
    flex-direction: row;
    align-items: center;
    height: 52px;
    padding-left: 12px;
    padding-right: 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(150, 168, 205, 0.16);
    border-left-width: 4px;
    border-left-color: rgba(0, 0, 0, 0);
}

.ltw-row--head {
    height: 40px;
    border-bottom-width: 2px;
    border-bottom-color: rgba(77, 163, 255, 0.5);
}

.ltw-row--winner {
    background-color: rgba(255, 200, 74, 0.022);
    border-left-color: rgb(255, 200, 74);
}

.ltw-row--local {
    background-color: rgba(77, 163, 255, 0.03);
    border-left-color: rgba(77, 163, 255, 0.8);
}

.ltw-cell {
    font-size: 24px;
    color: rgb(244, 247, 255);
    -unity-text-align: middle-left;
    flex-grow: 1;
    flex-basis: 0;
    margin-top: 0;
    margin-bottom: 0;
    white-space: nowrap;
}

.ltw-cell--seat {
    flex-grow: 1.5;
    -unity-font-style: bold;
}

.ltw-cell--num {
    -unity-text-align: middle-right;
}

/* The finish column. Narrow on purpose: it holds "1st" through "8th" and a dash, and at an equal
   share of the row it would take as much width as GOLD for a third of the content. */
.ltw-cell--rank {
    flex-grow: 0.45;
    -unity-text-align: middle-left;
    color: rgb(150, 167, 199);
    -unity-font-style: bold;
}

.ltw-row--head .ltw-cell {
    font-size: 17px;
    letter-spacing: 3px;
    color: rgb(104, 122, 158);
    -unity-font-style: bold;
}

.ltw-row--winner .ltw-cell {
    color: rgb(255, 200, 74);
    -unity-font-style: bold;
}

.ltw-cell--out {
    color: rgb(104, 122, 158);
}

/* ---------------------------------------------------------------- codex */

/*
 * The codex is the one shell screen whose content does not fit the column's usual rhythm: it has a
 * fixed-size image, six stat tiles and a fifteen-icon rail all competing for the same height. The
 * column keeps its width and its enter transition; everything below tightens the vertical spacing
 * that the title and pause screens can afford to be generous with.
 */

.ltw-tabs {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 18px;
}

.ltw-tab {
    font-size: 22px;
    letter-spacing: 4px;
    -unity-font-style: bold;
    color: rgb(104, 122, 158);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-bottom-width: 3px;
    border-bottom-color: rgba(0, 0, 0, 0);
    padding-left: 26px;
    padding-right: 26px;
    padding-top: 10px;
    padding-bottom: 8px;
    margin-left: 6px;
    margin-right: 6px;
    transition-property: color, border-bottom-color;
    transition-duration: 140ms;
}

.ltw-tab--current {
    color: rgb(244, 247, 255);
    border-bottom-color: rgb(255, 200, 74);
}

/*
 * The stage. A fixed square because the render texture is square and a non-uniform element would
 * stretch the model rather than letterbox it — scale-to-fit is not available for a background
 * image bound from a RenderTexture the way it is for a sprite. It matches the render target's 4:3
 * exactly, so the pixel ratio is 1:1 at the column's full width.
 *
 * The camera clears to alpha zero, so this element's own background is what shows around the
 * silhouette. That is deliberate: it means the unit sits in the screen's field rather than in a
 * black box nothing else on the composition has.
 */
.ltw-codex-preview {
    width: 640px;
    height: 480px;
    align-self: center;
    background-color: rgba(77, 163, 255, 0.05);
    border-width: 2px;
    border-color: rgba(77, 163, 255, 0.24);
    margin-bottom: 20px;
}

.ltw-codex-name {
    font-size: 54px;
    letter-spacing: 2px;
    color: rgb(244, 247, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-top: 2px;
    margin-bottom: 6px;
    white-space: normal;
    text-shadow: 0 4px 18px rgba(4, 7, 16, 0.95);
}

/* The behaviour line. Quieter than the blurb because it is a list of facts, not a sentence. */
.ltw-codex-traits {
    font-size: 20px;
    color: rgb(150, 168, 205);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-top: 16px;
    margin-bottom: 4px;
}

/* The stat tiles are tighter here than on the pause screen, which shows three rather than six. */
.ltw-stat__value--codex {
    font-size: 34px;
}

/*
 * The whole half, grouped one row per category, so the grouping reads off the layout without
 * needing three headings. Rows are built in code rather than produced by a wrap: a wrap only
 * lands on the category boundaries while every category is the same size, and it stopped doing
 * that the moment a sixth Arcane tower was added.
 */
.ltw-codex-rail {
    flex-direction: column;
    margin-top: 18px;
    margin-bottom: 14px;
}

/* One row per category, built explicitly rather than left to a wrap — see CodexScreenView.BuildRail. */
.ltw-codex-rail-row {
    flex-direction: row;
    justify-content: center;
}

.ltw-codex-chip {
    width: 108px;
    height: 108px;
    margin: 5px;
    padding: 0;
    background-color: rgba(77, 163, 255, 0.05);
    background-size: 74% 74%;
    background-position: center;
    background-repeat: no-repeat;
    border-width: 2px;
    border-color: rgba(150, 168, 205, 0.2);
    transition-property: border-color, background-color, scale;
    transition-duration: 140ms;
}

.ltw-codex-chip:hover {
    border-color: rgba(77, 163, 255, 0.6);
}

.ltw-codex-chip--current {
    border-color: rgb(255, 200, 74);
    background-color: rgba(255, 200, 74, 0.1);
    scale: 1.06 1.06;
}

.ltw-codex-nav {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 6px;
}

/* Overrides .ltw-action's full-width block, so PREV and NEXT sit either side of the counter. */
.ltw-codex-step {
    flex-grow: 1;
    flex-basis: 0;
    margin-top: 0;
    margin-bottom: 0;
}

.ltw-codex-position {
    font-size: 24px;
    letter-spacing: 3px;
    color: rgb(150, 168, 205);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    width: 160px;
    margin-top: 0;
    margin-bottom: 0;
}

/*
 * The no-model state. Stats land before art on this roster — the Twin Crescent Ward shipped
 * playable with no prefab, no icon and no visual profile — so "this unit exists and its model does
 * not" is a state the codex genuinely has to render, not a defensive branch.
 *
 * Hidden by default and shown by class, so the normal case costs no layout.
 */
.ltw-codex-pending {
    display: none;
}

.ltw-codex-pending.is-shown {
    display: flex;
    flex-grow: 1;
    font-size: 26px;
    letter-spacing: 5px;
    color: rgb(104, 122, 158);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* A rail chip standing in for an icon that has not been drawn yet. */
.ltw-codex-chip--textual {
    font-size: 20px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    color: rgb(150, 168, 205);
    white-space: normal;
}


/* ---------------------------------------------------------------- how to play */

/*
 * Five cards in the codex's frame. The headline is the codex name's size rather than the 82px
 * screen headline: "PLACE YOUR WARDS" at 82px with 6px tracking is wider than the column, and a
 * headline that has to wrap onto a second line loses the one-glance quality that makes it a
 * headline rather than a paragraph.
 */
.ltw-howto-headline {
    font-size: 54px;
    letter-spacing: 3px;
    color: rgb(244, 247, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-top: 2px;
    margin-bottom: 0;
    white-space: normal;
    text-shadow: 0 4px 18px rgba(4, 7, 16, 0.95);
}

/* Larger than .ltw-note: this is the whole point of the screen, not a caption under something. */
.ltw-howto-body {
    font-size: 27px;
    color: rgb(150, 168, 205);
    -unity-text-align: middle-center;
    white-space: normal;
    margin-top: 24px;
    margin-bottom: 0;
    text-shadow: 0 3px 12px rgba(4, 7, 16, 0.95);
}

/*
 * The preview slot. Fixed height so paging never moves the body copy or the nav; every preview
 * is a child of it and exactly one carries .is-shown. Sized to the stage (the tallest of them) so
 * the smaller previews centre inside it rather than the slot growing to fit the stage.
 */
.ltw-howto-slot {
    width: 100%;
    height: 450px;
    align-items: center;
    justify-content: center;
    margin-top: 6px;
    margin-bottom: 0;
}

.ltw-howto-preview {
    display: none;
}

.ltw-howto-preview.is-shown {
    display: flex;
}

/* The turntable, at the codex's 4:3 but smaller, because this screen has copy to leave room for. */
.ltw-howto-stage {
    width: 600px;
    height: 450px;
    align-items: center;
    justify-content: center;
    background-color: rgba(77, 163, 255, 0.05);
    border-width: 2px;
    border-color: rgba(77, 163, 255, 0.24);
}

/*
 * The maze card: a 5x7 lane drawn from plain cells, no art. Gate at the top, leak gate at the
 * bottom, and a path that bends around two ward cells — which is the whole lesson, so the path
 * is the loudest thing on it and the empty platforms the quietest.
 *
 * Cell arithmetic: 7 rows of (54 + 3 + 3) = 420, plus 10 padding and 2 border each side = 444,
 * which is the slot's 450 with a few units to spare. A 56px cell overshot it.
 */
.ltw-maze {
    flex-direction: column;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 10px;
    padding-bottom: 10px;
    background-color: rgba(77, 163, 255, 0.04);
    border-width: 2px;
    border-color: rgba(77, 163, 255, 0.24);
}

.ltw-maze__row {
    flex-direction: row;
}

.ltw-maze__cell {
    width: 54px;
    height: 54px;
    margin-left: 3px;
    margin-right: 3px;
    margin-top: 3px;
    margin-bottom: 3px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    background-color: rgba(150, 168, 205, 0.06);
    border-width: 1px;
    border-color: rgba(150, 168, 205, 0.14);
}

.ltw-maze__cell--path {
    background-color: rgba(77, 163, 255, 0.22);
    border-color: rgba(77, 163, 255, 0.65);
}

.ltw-maze__cell--tower {
    background-color: rgba(155, 108, 255, 0.42);
    border-width: 2px;
    border-color: rgb(155, 108, 255);
}

.ltw-maze__cell--gate {
    background-color: rgba(255, 200, 74, 0.28);
    border-width: 2px;
    border-color: rgb(255, 200, 74);
}

/* The grow card: one income bar with the tier marks under it. */
.ltw-income {
    width: 100%;
    max-width: 600px;
    padding-left: 32px;
    padding-right: 32px;
    padding-top: 30px;
    padding-bottom: 26px;
    background-color: rgba(77, 163, 255, 0.05);
    border-width: 2px;
    border-color: rgba(77, 163, 255, 0.24);
}

.ltw-income__row {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 16px;
}

.ltw-income__label {
    font-size: 19px;
    letter-spacing: 3px;
    color: rgb(104, 122, 158);
    -unity-font-style: bold;
    margin-top: 0;
    margin-bottom: 6px;
}

/* Mint, the HUD's own income colour, so the bar and the readout it stands for agree. */
.ltw-income__value {
    font-size: 46px;
    color: rgb(89, 225, 182);
    -unity-font-style: bold;
    margin-top: 0;
    margin-bottom: 0;
}

.ltw-income__track {
    height: 26px;
    background-color: rgba(150, 168, 205, 0.12);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

.ltw-income__fill {
    height: 100%;
    width: 62%;
    background-color: rgb(89, 225, 182);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
}

/* Ordinal only: the marks say tiers come in order on this bar, not where the thresholds are. */
.ltw-income__tiers {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 12px;
}

.ltw-income__tier {
    font-size: 17px;
    letter-spacing: 3px;
    color: rgb(104, 122, 158);
    -unity-font-style: bold;
    margin-top: 0;
    margin-bottom: 0;
}

.ltw-income__tier--reached {
    color: rgb(89, 225, 182);
}

.ltw-income__caption {
    font-size: 19px;
    letter-spacing: 3px;
    color: rgb(150, 168, 205);
    -unity-text-align: middle-center;
    margin-top: 26px;
    margin-bottom: 0;
}

/* The survive card: the number, large. */
.ltw-lives {
    align-items: center;
    justify-content: center;
}

.ltw-lives__value {
    font-size: 200px;
    color: rgb(244, 247, 255);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-top: 0;
    margin-bottom: 0;
    text-shadow: 0 8px 28px rgba(4, 7, 16, 0.95);
}

/* The HUD's lives red, for the same reason the income bar is mint. */
.ltw-lives__label {
    font-size: 26px;
    letter-spacing: 8px;
    color: rgb(255, 82, 61);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-top: 0;
    margin-bottom: 0;
}

.ltw-lives__caption {
    font-size: 19px;
    letter-spacing: 3px;
    color: rgb(104, 122, 158);
    -unity-text-align: middle-center;
    margin-top: 18px;
    margin-bottom: 0;
}

/* ---------------------------------------------------------------- first run */

/* The title's mark and wordmark, reduced, so the offer reads as a card over the title. */
.ltw-brand-mark--small {
    width: 110px;
    height: 95px;
    margin-bottom: 10px;
}

.ltw-wordmark--small {
    font-size: 54px;
}

/*
 * The card. A framed panel on the field rather than a second full-screen composition, because
 * the choice it offers is small and a full-height layout would leave two voids around one
 * paragraph.
 */
.ltw-offer {
    width: 100%;
    padding-left: 40px;
    padding-right: 40px;
    padding-top: 38px;
    padding-bottom: 36px;
    background-color: rgba(77, 163, 255, 0.045);
    border-width: 2px;
    border-color: rgba(77, 163, 255, 0.34);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-bottom-right-radius: 14px;
}

.ltw-offer__headline {
    font-size: 70px;
}

.ltw-offer__body {
    font-size: 25px;
    margin-top: 0;
    margin-bottom: 18px;
}

/* ---------------------------------------------------------------- coach strip */

/*
 * The strip rides over a live board, so unlike a screen it has no field behind it and must carry
 * its own opacity. 0.94 of night ink: composited in linear it lands nearly opaque, which is the
 * intent — the copy has to read over creeps and health bars.
 *
 * Top margin is the HUD's compact strip plus a gap. HudView draws its header 52 * UiScale tall,
 * TopMargin below the safe area; at the 1080x1920 capture surface UiScale is 2.06 and TopMargin
 * 23 device px, so the header's bottom edge sits at 130 device px — and this panel is matched on
 * height against a 2340 reference, so that is 158 reference units. 176 clears it with a gap and
 * holds on a 19.5:9 handset too (159 there). It does NOT clear the HUD's stats drawer when that
 * is expanded (that reaches ~364); a practice match is expected to start with it collapsed.
 *
 * The strip sits inside a .ltw-safe wrapper, which ShellScreenView pads by the device insets, so
 * this margin is measured from the safe area exactly as the HUD's own TopMargin is.
 */
.ltw-coach {
    display: none;
    opacity: 0;
    translate: 0 -14px;
    width: 92%;
    max-width: 780px;
    margin-top: 176px;
    padding-left: 24px;
    padding-right: 20px;
    padding-top: 14px;
    padding-bottom: 16px;
    background-color: rgba(9, 13, 27, 0.94);
    border-width: 2px;
    border-color: rgba(255, 200, 74, 0.6);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    transition-property: opacity, translate;
    transition-duration: 200ms;
    transition-timing-function: ease-out;
}

.ltw-coach.is-shown {
    display: flex;
}

.ltw-coach.is-entered {
    opacity: 1;
    translate: 0 0;
}

.ltw-coach__head {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

/* Gold rather than the eyebrow's arcane blue: this is coaching, and gold is the strip's accent. */
.ltw-coach__eyebrow {
    font-size: 19px;
    letter-spacing: 5px;
    color: rgb(255, 200, 74);
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    margin-top: 0;
    margin-bottom: 0;
    white-space: nowrap;
}

.ltw-coach__body {
    font-size: 25px;
    color: rgb(244, 247, 255);
    -unity-text-align: middle-left;
    white-space: normal;
    margin-top: 6px;
    margin-bottom: 0;
}

.ltw-coach__foot {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 10px;
    min-height: 58px;
}

.ltw-coach__dots {
    flex-direction: row;
    align-items: center;
}

.ltw-coach__dot {
    width: 14px;
    height: 14px;
    margin-right: 12px;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    border-bottom-left-radius: 7px;
    border-bottom-right-radius: 7px;
    background-color: rgba(150, 168, 205, 0.28);
    transition-property: background-color, scale;
    transition-duration: 140ms;
}

.ltw-coach__dot--done {
    background-color: rgba(255, 200, 74, 0.55);
}

.ltw-coach__dot--current {
    background-color: rgb(255, 200, 74);
    scale: 1.3 1.3;
}

/* Overrides .ltw-action's block sizing: these sit in a row and size to their label. */
.ltw-coach__action {
    height: 58px;
    min-width: 150px;
    flex-shrink: 0;
    font-size: 21px;
    letter-spacing: 3px;
    margin-top: 0;
    padding-left: 22px;
    padding-right: 22px;
}

.ltw-coach__action--skip {
    height: 44px;
    min-width: 0;
    font-size: 18px;
    padding-left: 12px;
    padding-right: 0;
}

/* NEXT only appears on a step that needs a tap; the foot keeps its height so the strip does not jump. */
.ltw-coach__action.is-hidden {
    display: none;
}
