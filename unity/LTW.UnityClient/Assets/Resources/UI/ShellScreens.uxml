<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="ShellScreens.uss" />

    <!--
        The three shell screens, all present in one document and switched by display.

        One document rather than three, because the shell is a single place in the app and this
        keeps the enter transition, the safe-area padding and the backdrop layering defined once.
        Only one screen is ever .is-shown; the rest are display:none, so they cost no layout and
        cannot take a pointer.

        Nothing here is interactive except the Buttons: every container and label is
        picking-mode="Ignore" so a stray pick never lands on a backdrop.
    -->
    <ui:VisualElement name="shell-root" class="ltw-shell" picking-mode="Ignore">

        <!-- ============================================================ TITLE -->
        <ui:VisualElement name="screen-title" class="ltw-screen" picking-mode="Ignore">
            <ui:VisualElement name="title-field" class="ltw-field ltw-field--solid" picking-mode="Ignore" />
            <ui:VisualElement name="title-glow" class="ltw-glow" picking-mode="Ignore" />
            <ui:VisualElement name="title-safe" class="ltw-safe" picking-mode="Ignore">
                <ui:VisualElement class="ltw-column" picking-mode="Ignore">
                    <ui:VisualElement class="ltw-spacer" picking-mode="Ignore" />

                    <ui:VisualElement class="ltw-brand-mark" picking-mode="Ignore" />
                    <ui:Label text="COMPETITIVE TOWER WARS" class="ltw-eyebrow" picking-mode="Ignore" />
                    <ui:Label text="LINE WARS" class="ltw-wordmark" picking-mode="Ignore" />
                    <ui:VisualElement class="ltw-rule" picking-mode="Ignore" />
                    <ui:Label text="Build. Send. Outlast." class="ltw-tagline" picking-mode="Ignore" />

                    <ui:VisualElement class="ltw-spacer ltw-spacer--tight" picking-mode="Ignore" />

                    <ui:Button name="title-start" text="START GAME" class="ltw-action ltw-action--primary" />
                    <ui:Button name="title-howto" text="HOW TO PLAY" class="ltw-action ltw-action--secondary" />
                    <ui:Button name="title-codex" text="CODEX" class="ltw-action ltw-action--secondary" />
                    <ui:Button name="title-settings" text="SETTINGS" class="ltw-action ltw-action--secondary" />
                    <ui:Button name="title-quit" text="QUIT" class="ltw-action ltw-action--tertiary" />

                    <ui:Label name="title-footer" text="Prototype local vertical slice" class="ltw-footer" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ============================================================ CODEX -->
        <!--
            One unit at a time: its model turning on a stage rendered into codex-preview, its stat
            tiles built in code into codex-stats, and an icon rail of the whole half underneath.

            codex-preview deliberately DOES take picks even though it is not a button — it is the
            element the render texture is bound to, and leaving it ignorable made no difference
            except to make a future drag-to-turn gesture impossible to add.
        -->
        <ui:VisualElement name="screen-codex" class="ltw-screen" picking-mode="Ignore">
            <ui:VisualElement name="codex-field" class="ltw-field ltw-field--solid" picking-mode="Ignore" />
            <ui:VisualElement name="codex-glow" class="ltw-glow" picking-mode="Ignore" />
            <ui:VisualElement name="codex-safe" class="ltw-safe" picking-mode="Ignore">
                <!--
                    No leading spacer, unlike every other screen. The spacers exist to compose
                    sparse screens against the slack; this one has a 560px stage, six stat tiles and
                    a fifteen-icon rail, so its problem is the opposite one and the slack it has
                    left is better spent on breathing room between those than on a void above them.
                -->
                <ui:VisualElement class="ltw-column" picking-mode="Ignore">
                    <ui:VisualElement name="codex-tabs" class="ltw-tabs">
                        <ui:Button name="codex-tab-wards" text="WARDS" class="ltw-tab ltw-tab--current" />
                        <ui:Button name="codex-tab-creeps" text="CREEPS" class="ltw-tab" />
                    </ui:VisualElement>

                    <ui:VisualElement name="codex-preview" class="ltw-codex-preview">
                        <ui:Label name="codex-preview-pending" text="MODEL PENDING" class="ltw-codex-pending" picking-mode="Ignore" />
                    </ui:VisualElement>

                    <ui:Label name="codex-eyebrow" text="WARD · ARCANE" class="ltw-eyebrow" picking-mode="Ignore" />
                    <ui:Label name="codex-name" text="ARROW TOWER" class="ltw-codex-name" picking-mode="Ignore" />
                    <ui:Label name="codex-blurb" text="-" class="ltw-note" picking-mode="Ignore" />

                    <ui:VisualElement name="codex-stats" picking-mode="Ignore" />

                    <ui:Label name="codex-traits" text="-" class="ltw-codex-traits" picking-mode="Ignore" />

                    <ui:VisualElement name="codex-rail" class="ltw-codex-rail" />

                    <ui:VisualElement name="codex-nav" class="ltw-codex-nav">
                        <ui:Button name="codex-prev" text="◀ PREV" class="ltw-action ltw-action--secondary ltw-codex-step" />
                        <ui:Label name="codex-position" text="1 / 15" class="ltw-codex-position" picking-mode="Ignore" />
                        <ui:Button name="codex-next" text="NEXT ▶" class="ltw-action ltw-action--secondary ltw-codex-step" />
                    </ui:VisualElement>

                    <ui:Button name="codex-back" text="BACK" class="ltw-action ltw-action--tertiary" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ============================================================ PAUSE -->
        <ui:VisualElement name="screen-pause" class="ltw-screen" picking-mode="Ignore">
            <ui:VisualElement name="pause-field" class="ltw-field ltw-field--veil" picking-mode="Ignore" />
            <ui:VisualElement name="pause-safe" class="ltw-safe" picking-mode="Ignore">
                <ui:VisualElement class="ltw-column" picking-mode="Ignore">
                    <ui:VisualElement class="ltw-spacer ltw-spacer--tight" picking-mode="Ignore" />

                    <ui:Label text="MATCH HELD" class="ltw-eyebrow" picking-mode="Ignore" />
                    <ui:Label text="PAUSED" class="ltw-headline" picking-mode="Ignore" />
                    <ui:VisualElement class="ltw-rule ltw-rule--quiet" picking-mode="Ignore" />
                    <ui:Label name="pause-note" text="Ticks are stopped. Nothing moves until you resume." class="ltw-note" picking-mode="Ignore" />

                    <ui:VisualElement name="pause-stats" class="ltw-stats" picking-mode="Ignore">
                        <ui:VisualElement class="ltw-stat" picking-mode="Ignore">
                            <ui:Label name="pause-lives" text="-" class="ltw-stat__value" picking-mode="Ignore" />
                            <ui:Label text="LIVES" class="ltw-stat__label" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement class="ltw-stat" picking-mode="Ignore">
                            <ui:Label name="pause-gold" text="-" class="ltw-stat__value" picking-mode="Ignore" />
                            <ui:Label text="GOLD" class="ltw-stat__label" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:VisualElement class="ltw-stat" picking-mode="Ignore">
                            <ui:Label name="pause-income" text="-" class="ltw-stat__value" picking-mode="Ignore" />
                            <ui:Label text="INCOME" class="ltw-stat__label" picking-mode="Ignore" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="ltw-spacer" picking-mode="Ignore" />

                    <ui:Button name="pause-resume" text="RESUME" class="ltw-action ltw-action--primary" />
                    <ui:Button name="pause-settings" text="SETTINGS" class="ltw-action ltw-action--secondary" />
                    <ui:Button name="pause-reset" text="RESET MATCH" class="ltw-action ltw-action--secondary ltw-action--caution" />
                    <ui:Label text="Clears every tower and returns the board to READY." class="ltw-consequence" picking-mode="Ignore" />
                    <ui:Button name="pause-menu" text="EXIT TO TITLE" class="ltw-action ltw-action--tertiary" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ========================================================== RESULTS -->
        <ui:VisualElement name="screen-results" class="ltw-screen" picking-mode="Ignore">
            <ui:VisualElement name="results-field" class="ltw-field ltw-field--heavy" picking-mode="Ignore" />
            <ui:VisualElement name="results-glow" class="ltw-glow" picking-mode="Ignore" />
            <ui:VisualElement name="results-safe" class="ltw-safe" picking-mode="Ignore">
                <ui:VisualElement class="ltw-column" picking-mode="Ignore">
                    <ui:VisualElement class="ltw-spacer ltw-spacer--tight" picking-mode="Ignore" />

                    <ui:Label text="MATCH COMPLETE" class="ltw-eyebrow" picking-mode="Ignore" />
                    <ui:Label name="results-headline" text="DEFEAT" class="ltw-headline" picking-mode="Ignore" />
                    <ui:Label name="results-note" text="-" class="ltw-note" picking-mode="Ignore" />
                    <ui:VisualElement class="ltw-rule ltw-rule--quiet" picking-mode="Ignore" />

                    <ui:VisualElement name="results-table" class="ltw-table" picking-mode="Ignore" />

                    <ui:VisualElement class="ltw-spacer ltw-spacer--tight" picking-mode="Ignore" />

                    <ui:Button name="results-rematch" text="REMATCH" class="ltw-action ltw-action--primary" />
                    <ui:Button name="results-settings" text="SETTINGS" class="ltw-action ltw-action--secondary" />
                    <ui:Button name="results-menu" text="EXIT TO TITLE" class="ltw-action ltw-action--tertiary" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
