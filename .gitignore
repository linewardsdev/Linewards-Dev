# .NET
**/bin/
**/obj/
*.user
*.suo
*.userprefs
.vs/
.vscode/
.idea/

# Unity generated files
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
Recordings/
# IL2CPP/CMake intermediate cache for Android builds — found leaking into `git status` the first
# time this project ever built for Android (AndroidBuildRunner, 2026-09-07); not under Library/
# or Temp/ so the patterns above don't already cover it.
.utmp/
unity/LTW.UnityClient/Assets/Plugins/LTW.Simulation.dll
unity/LTW.UnityClient/Assets/Plugins/LTW.Simulation.dll.meta

# Stray Unity project generated when the Hub is pointed at the repo root
# instead of unity/LTW.UnityClient
/Assets/
/Packages/
/ProjectSettings/

# Nested clone of this repository
/LTW/

# FBX embedded-media caches. Unity regenerates these on import and they are
# byte-identical duplicates of the sibling *_Textures/ folders.
*.fbm/
*.fbm.meta

# Unity-generated IDE files
*.csproj
*.sln
*.slnx
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Keep the root .NET solution and projects
!LTW.sln
!src/**/*.csproj
!tests/**/*.csproj

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Unity mono crash dumps, written into the project root on unclean editor exit
mono_crash.mem.*.blob

# Byte-cache from the Blender art-pipeline scripts. They only started producing it when the
# rig scripts began importing a shared module (tools/art_pipeline/blender_game_camera.py)
# rather than each duplicating the match-camera maths.
__pycache__/
*.pyc

# Agent worktrees and session scratch. These are nested git repos; committing them
# stages embedded repositories that a clone cannot resolve.
.claude/

# Local secrets for running LTW.MatchServer by hand. Never commit real credentials —
# see docs/PLAYFAB_SETUP.md's "Handling the Secret Key".
.env.local
